# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The domain and contact for HTTPS certificates (Let's Encrypt).
SITE_DOMAIN=monkstash.com
ACME_EMAIL=

# Public site URL (canonicals, sitemap, Open Graph) and the Monero network.
NEXT_PUBLIC_SITE_URL=https://monkstash.com
# The wallet's own address (needs the "wallet" DNS record). Its browser storage is then kept
# apart from the content pages. Changing it later moves users' wallets: their browsers would
# not see the old address's storage, so set it once, before launch.
NEXT_PUBLIC_WALLET_URL=https://wallet.monkstash.com
NEXT_PUBLIC_MONERO_NETWORK=mainnet

# Nodes the wallet relay forwards to (mainnet). https nodes are tried first. Plain http to a
# node on the internet can be read and changed on the way, so the server warns about it at
# start; it is fine for your own node on this machine, the private network or over Tor.
# Unconfirmed (0-conf) payments are only as trustworthy as these nodes: use your own node
# before relying on 0-conf for real sales.
MONERO_NODE_URLS=https://xmr-node.cakewallet.com:18081,http://node.sethforprivacy.com:18089,http://node.monerodevs.org:18089
# Mainnet node for fee statistics and the donation tracker.
MONERO_STATS_NODE_URL=https://xmr-node.cakewallet.com:18081

# Optional backup price source.
LIVECOINWATCH_API_KEY=

# After the onion service is up, set this to advertise it (Tor Browser shows a ".onion available" button):
# ONION_LOCATION_HEADER=Onion-Location http://YOURONIONADDRESS.onion{uri}
ONION_LOCATION_HEADER=

# Staging only (a test hostname): keep search engines out. Leave empty in production.
# STAGING_ROBOTS_HEADER=X-Robots-Tag "noindex, nofollow"
STAGING_ROBOTS_HEADER=
