# MonkStash website and wallet. Build from the repository root:
#   docker compose -f deploy/docker-compose.yml build
# The base image is pinned by digest and the build ID is the source commit, so anyone can rebuild
# a release and get byte-identical files (see scripts/verify-build.mjs and /verify).
ARG NODE_IMAGE=node:24.22.1-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
FROM ${NODE_IMAGE} AS build
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/wallet-core packages/wallet-core
COPY packages/node-client packages/node-client
COPY apps/web apps/web
# The node installer is served at /server/install.sh, so its hash is in the build manifest too.
COPY server/monkstash-server.sh apps/web/public/server/install.sh
COPY server/monkstash-server.sh.sig apps/web/public/server/install.sh.sig
RUN pnpm install --frozen-lockfile --filter @quietmint/web...
# Public settings are baked into the pages at build time.
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_MONERO_NETWORK=mainnet
ARG NEXT_PUBLIC_WALLET_URL=
# The public source commit this build is made from; becomes the Next.js build ID.
ARG BUILD_COMMIT=
ENV BUILD_ID=$BUILD_COMMIT \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_WALLET_URL=$NEXT_PUBLIC_WALLET_URL \
    NEXT_PUBLIC_MONERO_NETWORK=$NEXT_PUBLIC_MONERO_NETWORK \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @quietmint/web build && node apps/web/scripts/build-manifest.mjs

FROM ${NODE_IMAGE}
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 \
    DONATIONS_STATE_DIR=/data/donations
WORKDIR /app
COPY --from=build /src/apps/web/.next/standalone ./
COPY --from=build /src/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /src/apps/web/public ./apps/web/public
# Next.js writes refreshed pages (fees, prices, donations) into .next; the rest of the code stays root-owned.
RUN mkdir -p /data /app/apps/web/.next/cache && chown node:node /data && chown -R node:node /app/apps/web/.next
USER node
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
