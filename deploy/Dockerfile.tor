# Tor, only to publish the site as an onion service (not a relay, not an exit).
FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tor && rm -rf /var/lib/apt/lists/*
COPY torrc /etc/tor/torrc
RUN mkdir -p /var/lib/tor/monkstash && chown -R debian-tor:debian-tor /var/lib/tor && chmod 700 /var/lib/tor/monkstash
USER debian-tor
CMD ["tor", "-f", "/etc/tor/torrc"]
