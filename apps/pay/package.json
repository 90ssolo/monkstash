{
  "name": "@quietmint/pay",
  "version": "0.1.0",
  "description": "MonkStash Pay: a self-hosted, non-custodial Monero payment server for online shops.",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "start": "node dist/server.mjs",
    "dev": "rolldown -c rolldown.config.mjs && node --env-file-if-exists=.env dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quietmint/wallet-core": "workspace:*",
    "monero-ts": "0.11.20",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.5",
    "rolldown": "1.2.13",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
