# MonkStash Pay settings. Copy to .env and fill in. Never commit .env.

# Network: mainnet for real money, stagenet for testing.
PAY_NETWORK=mainnet

# Your shop wallet's PRIMARY address and PRIVATE VIEW key. The view key lets this server see
# incoming payments; it can never spend. Never put your seed or spend key here.
PAY_ADDRESS=
PAY_VIEW_KEY=
# Required. Block height to start scanning from: the height when you created the wallet (or a bit before).
PAY_RESTORE_HEIGHT=
# Wallet account for invoice addresses (default 1). One wallet account per Pay server: never
# share an account with a till, payment links or another Pay server, or two orders could get
# the same address. Account 0 is the one wallet apps use by default.
PAY_ACCOUNT=1

# A Monero node (daemon RPC). Your own node is best; it sees this server's IP and sync requests.
PAY_NODE_URL=
PAY_NODE_USERNAME=
PAY_NODE_PASSWORD=

# Secret for your shop to call the API. Generate with: openssl rand -hex 32
PAY_API_KEY=

# Optional: where to send signed "invoice paid" events, and the signing secret (openssl rand -hex 32).
PAY_WEBHOOK_URL=
PAY_WEBHOOK_SECRET=

# The public HTTPS address of this server (used in checkout links), and where it listens.
PAY_PUBLIC_URL=https://pay.yourshop.com
PAY_PORT=8080
PAY_HOST=0.0.0.0
PAY_DATA_DIR=./data
# Set to 1 when a reverse proxy (Caddy, nginx) is the only way to reach this server, so rate
# limits use the visitor's address. Leave empty if clients can reach the port directly.
PAY_TRUST_PROXY=

# Checkout details.
PAY_SHOP_NAME=
# EUR, USD, GBP, CHF, ... or XMR.
PAY_CURRENCY=EUR
# When is an order paid? quick | standard | safe (see README). quick accepts small payments with
# 0 confirmations: never use it for goods delivered instantly (downloads, licence keys, gift cards).
PAY_CONFIRMATIONS=standard
# Minutes a fiat price is held before the invoice expires.
PAY_EXPIRY_MINUTES=30
# Most unpaid, unexpired invoices open at once; new ones are refused (HTTP 503) above this.
PAY_MAX_OPEN_INVOICES=500

# Optional backup price source (free key from livecoinwatch.com).
LIVECOINWATCH_API_KEY=
