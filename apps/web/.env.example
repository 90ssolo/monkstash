# Public site URL used for canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Which Monero network the wallet uses: mainnet | stagenet | testnet
# stagenet is a free test network (free faucet coins, fast sync). Use it for testing.
NEXT_PUBLIC_MONERO_NETWORK=stagenet

# Monero node(s) the proxy forwards to, comma separated, tried in order.
# Stagenet (default port 38081/38089):
MONERO_NODE_URLS=http://node.sethforprivacy.com:38089,http://stagenet.xmr-tw.org:38081,http://node.monerodevs.org:38089
# Mainnet (swap in when you go live, and set NEXT_PUBLIC_MONERO_NETWORK=mainnet):
# MONERO_NODE_URLS=http://node.sethforprivacy.com:18089,http://xmr-node.cakewallet.com:18081,http://node.monerodevs.org:18089

# Mainnet node (restricted RPC) used server-side for the fee calculator statistics.
# Content pages only read the cached result; no visitor data reaches this node.
MONERO_STATS_NODE_URL=https://xmr-node.cakewallet.com:18081

# Optional fifth price source for /api/price (free key from livecoinwatch.com). Leave empty to skip.
LIVECOINWATCH_API_KEY=
